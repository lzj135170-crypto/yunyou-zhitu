# 云游织图后端配置示例。
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不能提交。
#
# ⚠️ 这里的值都是占位符，不要直接用于生产环境。

# ---------- 数据库 ----------
# 必填。业务库连接串（PostgreSQL）。
DATABASE_URL=postgresql+psycopg2://postgres:change-me@127.0.0.1:5432/travel

# 必填。JWT 签名密钥，生产环境请用足够长的随机字符串。
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 缓存 ----------
# Redis 是旁路缓存；不启动 Redis 时自动退到进程内缓存。
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=1800
RESULT_CACHE_TTL_SECONDS=600

# ---------- 大模型 ----------
# 不配置时智能体链路会降级；配置后才会真正调用模型。
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# LangGraph 检查点连接串（psycopg3 格式）。留空时由 DATABASE_URL 推导。
CHECKPOINT_DB_URL=

# ---------- 高德 Web 服务（仅后端使用） ----------
# 不要填前端 JS key；这里需要高德 Web 服务 key。
AMAP_WEB_SERVICE_KEY=
AMAP_HTTP_TIMEOUT_SECONDS=5
AMAP_MAP_ENABLED=true

# ---------- 本地模型 / RAG ----------
HF_ENDPOINT=https://hf-mirror.com
# 以下路径建议写绝对路径（相对路径会按启动进程的当前目录解析）。
HF_HOME=/absolute/path/to/Travel/models/huggingface
EMBEDDING_MODEL=/absolute/path/to/Travel/models/bge-m3
RERANKER_MODEL=/absolute/path/to/Travel/models/bge-reranker-v2-m3
# 留空表示从 DATABASE_URL 推导端口和库名 travel_vector。
VECTOR_DATABASE_URL=
KNOWLEDGE_DIR=/absolute/path/to/Travel/knowledge

# ---------- MCP ----------
MCP_ENABLED=false
MCP_AMAP_ENABLED=false
MCP_WEATHER_TRANSPORT=stdio
MCP_WEATHER_MODULE=app.mcp_servers.weather_server
MCP_WEATHER_URL=http://127.0.0.1:8765/mcp
MCP_WEATHER_TOOL_TIMEOUT_SECONDS=12
MCP_WEATHER_DOWN_RETRY_SECONDS=60
MCP_FALLBACK_DIRECT=true

# ---------- 生成后校验 / 熔断 ----------
GROUNDING_GUARD_ENABLED=true
GROUNDING_GUARD_RETRY=true
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
